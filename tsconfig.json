{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "declaration": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@gymai/functions": ["./functions/src"],
      "@gymai/functions/*": ["./functions/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "api/**/*",
    "functions/src/constants/**/*",
    "functions/src/data/**/*",
    "functions/src/firestore/**/*",
    "functions/src/services/exerciseSelectionService.ts",
    "functions/src/services/planBuilder.ts",
    "functions/src/services/profileService.ts",
    "functions/src/services/progressionService.ts",
    "functions/src/services/templateService.ts",
    "functions/src/services/weekAnalysisService.ts",
    "functions/src/services/nextWeekGenerationService.ts",
    "functions/src/types/chat.ts",
    "functions/src/types/history.ts",
    "functions/src/types/workout.ts",
    "functions/src/utils/errors.ts",
    "functions/src/utils/workoutErrors.ts",
    "functions/src/utils/planValidation.ts",
    "functions/src/utils/seededRandom.ts",
    "functions/src/utils/units.ts",
    "functions/src/functions/generateWorkoutPlan.ts",
    "functions/src/functions/validateWorkoutPlan.ts",
    "functions/src/functions/generateNextWeekPlan.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/__tests__",
    "functions/src/__tests__",
    "functions/lib",
    "functions/node_modules",
    "functions/src/services/aiService.ts",
    "functions/src/services/groqService.ts",
    "functions/src/services/openAIService.ts",
    "functions/src/functions/chatWithCoach.ts",
    "functions/src/index.ts",
    "functions/src/utils/validation.ts",
    "functions/src/utils/logging.ts"
  ]
}
